          {[0,1,2,3,4].map(i=><div key={i} style={{width:"9px",height:"9px",borderRadius:"50%",background:(!expired&&i<Math.min(5,Math.floor(client.points/20)))?C.tr:"rgba(212,87,30,0.2)",boxShadow:(!expired&&i<Math.min(5,Math.floor(client.points/20)))?"0 0 8px rgba(212,87,30,0.55)":"none",transition:"all 0.4s"}}/>)}
        </div>
      </div>
    </div>
  );
}

function ProgressBars({ client, rewards, lang, onRedeemRequest }) {
  const pts = pointsExpired(client.lastVisit) ? 0 : client.points;
  const [sent, setSent] = useState(null);
  return (
    <div style={{display:"flex",flexDirection:"column",gap:"12px"}}>
      {rewards.map(r=>{
        const pct=Math.min(100,(pts/r.cost)*100), ok=pts>=r.cost;
        const already=client.redeemRequest===r.id;
        const justSent=sent===r.id;
        return (
          <div key={r.id} style={{background:ok?"rgba(255,255,255,0.88)":"rgba(255,255,255,0.72)",borderRadius:"14px",padding:"14px 16px",backdropFilter:"blur(10px)",border:`1px solid ${ok?"rgba(42,157,143,0.45)":"rgba(13,92,82,0.14)"}`,transition:"all 0.3s",boxShadow:ok?"0 4px 20px rgba(13,92,82,0.12)":"none"}}>
            <div style={{display:"flex",justifyContent:"space-between",marginBottom:"10px",alignItems:"center"}}>
              <div style={{display:"flex",alignItems:"center",gap:"8px"}}>
                <span style={{fontSize:"22px"}}>{r.icon}</span>
                <div>
                  <div style={{fontSize:"13px",fontWeight:"700",color:C.text,fontFamily:"'Cormorant Garamond',serif"}}>{lang==="en"&&r.labelEn?r.labelEn:r.label}</div>
                  <div style={{fontSize:"10px",color:C.fnt}}>{r.cost} pts</div>
                </div>
              </div>
              {!ok && <span style={{fontSize:"11px",fontWeight:"700",color:C.fnt,padding:"3px 8px",borderRadius:"99px",flexShrink:0}}>{pts}/{r.cost}</span>}
            </div>
            <div style={{height:"7px",background:"rgba(13,92,82,0.11)",borderRadius:"99px",overflow:"hidden",marginBottom:ok?"12px":"0"}}>
              <div style={{height:"100%",width:`${pct}%`,background:ok?`linear-gradient(90deg,${C.tL},${C.t})`:`linear-gradient(90deg,${C.tr},${C.trD})`,borderRadius:"99px",transition:"width 0.7s cubic-bezier(0.34,1.4,0.64,1)"}}/>
            </div>
            {ok && (
              already || justSent ? (
                <div style={{background:"rgba(13,92,82,0.1)",borderRadius:"10px",padding:"10px 14px",textAlign:"center",fontSize:"12px",fontWeight:"700",color:C.t}}>
                  ✓ {lang==="en"?"Request sent! Staff will process it on your next visit.":"¡Solicitud enviada! El personal la procesará en tu próxima visita."}
                </div>
              ) : (
                <button onClick={()=>{onRedeemRequest(client.id,r.id);setSent(r.id);}} style={{
                  width:"100%",padding:"11px",borderRadius:"10px",border:"none",cursor:"pointer",
                  background:`linear-gradient(135deg,${C.tr},${C.trD})`,
                  color:"#fff",fontWeight:"800",fontSize:"13px",fontFamily:"'Nunito Sans',sans-serif",
                  boxShadow:"0 4px 16px rgba(212,87,30,0.38)",transition:"all 0.2s",letterSpacing:"0.3px"
                }}
                  onMouseEnter={e=>e.currentTarget.style.transform="translateY(-1px)"}
                  onMouseLeave={e=>e.currentTarget.style.transform=""}>
                  🎁 {lang==="en"?`Claim: ${r.labelEn||r.label}`:`Solicitar: ${r.label}`}
                </button>
              )
            )}
          </div>
        );
      })}
    </div>
  );
}

function HistoryList({ history, lang }) {
  if(!history.length) return <div style={{textAlign:"center",color:C.fnt,padding:"20px",fontSize:"13px"}}>{T[lang].noHistory}</div>;
  return (
    <div style={{display:"flex",flexDirection:"column",gap:"7px",maxHeight:"260px",overflowY:"auto",paddingRight:"2px"}}>
      {[...history].reverse().map((h,i)=>(
        <div key={i} style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"10px 12px",borderRadius:"10px",background:h.delta>0?"rgba(13,92,82,0.07)":"rgba(180,50,20,0.06)",border:`1px solid ${h.delta>0?"rgba(13,92,82,0.14)":"rgba(180,50,20,0.14)"}`}}>
          <div>
            <div style={{fontSize:"12px",fontWeight:"600",color:C.text}}>{h.type}</div>
            <div style={{fontSize:"10px",color:C.fnt,marginTop:"1px"}}>{h.date}</div>
          </div>
          <div style={{fontSize:"14px",fontWeight:"800",color:h.delta>0?C.t:"#c0391b",flexShrink:0,marginLeft:"8px"}}>{h.delta>0?"+":""}{h.delta} pts</div>
        </div>
      ))}
    </div>
  );
}

// ══════════════════════════════════════════════════════════════════════════
// VISTA CLIENTE
// ══════════════════════════════════════════════════════════════════════════
function ClientView({ clients, onRegister, currentId, setCurrentId, lang, rewards, exps, onRedeemRequest }) {
  const [tab, setTab] = useState("card");
  const [screen, setScreen] = useState("home");
  const [query, setQuery] = useState("");
  const [qErr, setQErr] = useState("");
  const [form, setForm] = useState({name:"",phone:""});
  const [fErr, setFErr] = useState("");
  const [newId, setNewId] = useState(null);

  const t = T[lang];
  const client = clients.find(c=>c.id===currentId);
  const pts = client && pointsExpired(client.lastVisit) ? 0 : client?.points || 0;
  const unread = client?.notifications?.filter(n=>!n.read).length || 0;

  const handleSearch = () => {
    const q = query.trim().toLowerCase();
    const found = clients.find(c=>
      c.id.toLowerCase()===q ||
      c.name.toLowerCase()===q ||
      c.phone.replace(/\D/g,"")===q.replace(/\D/g,"")
    );
    if(!found){setQErr(t.searchErr);return;}
    setCurrentId(found.id); setQErr(""); setQuery("");
  };

  const handleRegister = () => {
    if(!form.name.trim()||!form.phone.trim()){setFErr(t.fillAll);return;}
    const id=onRegister(form); setNewId(id); setScreen("registered");
  };

  if(screen==="registered") return (
    <div style={{display:"flex",flexDirection:"column",gap:"18px"}}>
      <Card title={t.registerOk} icon="🎉" accent>
        <div style={{textAlign:"center",padding:"8px 0 4px"}}>
          <div style={{fontSize:"13px",color:C.mut,marginBottom:"12px"}}>{t.yourId}</div>
          <div style={{fontSize:"34px",fontWeight:"800",color:C.tD,fontFamily:"'Cormorant Garamond',serif",letterSpacing:"3px",background:"rgba(13,92,82,0.08)",padding:"14px 20px",borderRadius:"14px",marginBottom:"10px"}}>{newId}</div>
          <div style={{fontSize:"12px",color:C.fnt,marginBottom:"20px",lineHeight:"1.7"}}>{t.saveId}</div>
          <Btn variant="primary" full onClick={()=>{setCurrentId(newId);setScreen("home");}}>
            {t.viewCard}
          </Btn>
        </div>
      </Card>
    </div>
  );

  if(client) return (
    <div style={{display:"flex",flexDirection:"column",gap:"14px"}}>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"center"}}>
        <div>
          <div style={{fontSize:"10px",letterSpacing:"2px",color:C.mut,textTransform:"uppercase"}}>{t.welcome}</div>
          <div style={{fontSize:"22px",fontFamily:"'Cormorant Garamond',serif",fontWeight:"700",color:C.tD}}>{client.name.split(" ")[0]} ✨</div>
        </div>
        <div style={{display:"flex",gap:"8px",alignItems:"center"}}>
          {unread>0&&<div style={{background:C.tr,color:"#fff",borderRadius:"99px",padding:"4px 10px",fontSize:"11px",fontWeight:"800",cursor:"pointer"}} onClick={()=>setTab("notif")}>🔔 {unread}</div>}
          <button onClick={()=>{setCurrentId(null);setScreen("home");setTab("card");}} style={{background:"rgba(13,92,82,0.1)",border:"none",borderRadius:"99px",padding:"6px 14px",cursor:"pointer",fontSize:"11px",color:C.tD,fontWeight:"700"}}>{t.logout}</button>
        </div>
      </div>

      <LoyaltyCard client={client} lang={lang} exps={exps}/>

      {/* Tabs */}
      <div style={{display:"flex",background:"rgba(255,255,255,0.55)",borderRadius:"12px",padding:"3px",border:"1px solid rgba(13,92,82,0.14)",gap:"2px"}}>
        {[{k:"card",l:t.progress},{k:"history",l:t.history},{k:"notif",l:`🔔${unread>0?` (${unread})`:""}`}].map(({k,l})=>(
          <button key={k} onClick={()=>setTab(k)} style={{flex:1,padding:"8px 4px",borderRadius:"10px",border:"none",cursor:"pointer",fontWeight:"700",fontSize:"11px",transition:"all 0.22s",fontFamily:"'Nunito Sans',sans-serif",
            background:tab===k?`linear-gradient(135deg,${C.tD},${C.t})`:"transparent",
            color:tab===k?C.sand:C.mut,boxShadow:tab===k?"0 2px 10px rgba(13,92,82,0.3)":"none"}}>{l}</button>
        ))}
      </div>

      {tab==="card"&&<ProgressBars client={client} rewards={rewards} lang={lang} onRedeemRequest={onRedeemRequest}/>}
      {tab==="history"&&<Card title={t.historyTitle} icon="📋"><HistoryList history={client.history} lang={lang}/></Card>}
      {tab==="notif"&&(
        <Card title={t.notifications} icon="🔔">
          {client.notifications.length===0
            ? <div style={{textAlign:"center",color:C.fnt,padding:"16px",fontSize:"13px"}}>{t.noNotif}</div>
            : <div style={{display:"flex",flexDirection:"column",gap:"8px"}}>
                {[...client.notifications].reverse().map((n,i)=>(
                  <div key={i} style={{padding:"10px 12px",borderRadius:"10px",background:n.read?"rgba(13,92,82,0.04)":"rgba(13,92,82,0.1)",border:`1px solid ${n.read?"rgba(13,92,82,0.1)":"rgba(13,92,82,0.25)"}`,fontSize:"13px",color:C.text,fontWeight:n.read?"400":"600"}}>
                    {n.msg}
                  </div>
                ))}
              </div>}
        </Card>
      )}

    </div>
  );

  return (
    <div style={{display:"flex",flexDirection:"column",gap:"18px"}}>
      <div style={{textAlign:"center",padding:"6px 0"}}>
        <div style={{display:"flex",justifyContent:"center",marginBottom:"8px"}}><Logo size={94}/></div>
        <div style={{fontSize:"11px",letterSpacing:"3px",color:C.mut,textTransform:"uppercase"}}>{lang==="en"?"Program of":t.loyalty.split(" ")[0]+" de"}</div>
        <div style={{fontSize:"30px",fontFamily:"'Cormorant Garamond',serif",fontWeight:"700",color:C.tD,lineHeight:"1.1"}}>{lang==="en"?"Loyalty":t.loyalty.split(" ").slice(1).join(" ")}</div>
        <div style={{fontSize:"12px",color:C.fnt,marginTop:"2px"}}>{t.appSub} · Mandala Thai</div>
      </div>

      {screen==="home"&&(
        <div style={{display:"flex",flexDirection:"column",gap:"10px"}}>
          <Btn variant="primary" full onClick={()=>setScreen("search")}>🔍 {t.accessCard}</Btn>
          <Btn variant="ghost" full onClick={()=>setScreen("register")}>✦ {t.firstVisit}</Btn>
        </div>
      )}

      {screen==="search"&&(
        <Card title={t.searchTitle} icon="🔍">
          <div style={{display:"flex",flexDirection:"column",gap:"12px"}}>
            <Inp label={t.searchLabel} value={query} onChange={e=>setQuery(e.target.value)} placeholder={t.namePh} hint={t.searchHint}/>
            {qErr&&<div style={{fontSize:"12px",color:"#c0391b",background:"rgba(192,57,27,0.09)",padding:"8px 12px",borderRadius:"8px"}}>{qErr}</div>}
            <div style={{display:"flex",gap:"9px"}}>
              <Btn variant="ghost" small onClick={()=>{setScreen("home");setQErr("");}}>{t.back}</Btn>
              <Btn variant="primary" onClick={handleSearch}>{t.searchBtn}</Btn>
            </div>
          </div>
        </Card>
      )}

      {screen==="register"&&(
        <Card title={t.register} icon="✦">
          <div style={{display:"flex",flexDirection:"column",gap:"11px"}}>
            <Inp label={t.nameLabel} value={form.name} onChange={e=>setForm({...form,name:e.target.value})} placeholder={t.namePh}/>
            <Inp label={t.phoneLabel} value={form.phone} onChange={e=>setForm({...form,phone:e.target.value})} placeholder={t.phonePh}/>
            {fErr&&<div style={{fontSize:"12px",color:"#c0391b",background:"rgba(192,57,27,0.09)",padding:"8px 12px",borderRadius:"8px"}}>{fErr}</div>}
            <div style={{display:"flex",gap:"9px"}}>
              <Btn variant="ghost" small onClick={()=>{setScreen("home");setFErr("");}}>{t.back}</Btn>
              <Btn variant="primary" onClick={handleRegister}>{t.registerBtn}</Btn>
            </div>
          </div>
        </Card>
      )}
    </div>
  );
}

