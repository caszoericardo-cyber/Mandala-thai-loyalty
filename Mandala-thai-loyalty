function Btn({ children, onClick, disabled, variant="primary", small, full }) {
  const s={border:"none",cursor:disabled?"not-allowed":"pointer",borderRadius:"99px",fontWeight:"700",letterSpacing:"0.5px",transition:"all 0.2s",outline:"none",fontFamily:"'Nunito Sans',sans-serif",fontSize:small?"11px":"13px",padding:small?"7px 14px":"11px 24px",opacity:disabled?0.38:1,whiteSpace:"nowrap",width:full?"100%":"auto",display:full?"block":"inline-block",textAlign:"center"};
  const v={
    primary:{background:`linear-gradient(135deg,${C.tD},${C.t})`,color:C.sand,boxShadow:"0 4px 16px rgba(13,92,82,0.38)"},
    terra:  {background:`linear-gradient(135deg,${C.tr},${C.trD})`,color:"#fff",boxShadow:"0 4px 16px rgba(212,87,30,0.38)"},
    danger: {background:"linear-gradient(135deg,#c0391b,#a52d14)",color:"#fff",boxShadow:"0 4px 14px rgba(192,57,27,0.3)"},
    ghost:  {background:"rgba(13,92,82,0.09)",color:C.tD,border:"1px solid rgba(13,92,82,0.25)"},
    warn:   {background:"linear-gradient(135deg,#e07020,#c05a10)",color:"#fff",boxShadow:"0 4px 14px rgba(200,90,20,0.3)"},
    green:  {background:"linear-gradient(135deg,#1a7a6e,#0d5c52)",color:"#fff",boxShadow:"0 4px 14px rgba(13,92,82,0.3)"},
  };
  return <button onClick={disabled?undefined:onClick} style={{...s,...v[variant]}} onMouseEnter={e=>{if(!disabled)e.currentTarget.style.transform="translateY(-1px) scale(1.02)";}} onMouseLeave={e=>{e.currentTarget.style.transform="";}}>{children}</button>;
}

