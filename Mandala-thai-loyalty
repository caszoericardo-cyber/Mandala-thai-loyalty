// LOGO SVG
// ══════════════════════════════════════════════════════════════════════════
function Logo({ size = 90 }) {
  const tris = Array.from({length:24},(_,i)=>{
    const a1=(i*15)*Math.PI/180, a2=((i+1)*15)*Math.PI/180, r1=74, r2=82;
    return { pts:[[r1,a1],[r2,a1],[r2,a2],[r1,a2]].map(([r,a])=>`${(100+r*Math.cos(a)).toFixed(2)},${(100+r*Math.sin(a)).toFixed(2)}`).join(" "), fill:i%2===0?"#d4571e":"#1a7a6e" };
  });
  return (
    <svg width={size} height={size} viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="ls2"><feDropShadow dx="0" dy="3" stdDeviation="5" floodColor="#0d5c52" floodOpacity="0.22"/></filter>
        <clipPath id="lc2"><circle cx="100" cy="100" r="88"/></clipPath>
        <radialGradient id="cg2" cx="50%" cy="50%" r="50%"><stop offset="0%" stopColor="#5a7a50"/><stop offset="100%" stopColor="#2e4828"/></radialGradient>
      </defs>
      <circle cx="100" cy="100" r="88" fill="#e8dcc8" filter="url(#ls2)"/>
      <circle cx="100" cy="100" r="88" fill="none" stroke="#a09070" strokeWidth="5"/>
      <circle cx="100" cy="100" r="82" fill="none" stroke="#c8b890" strokeWidth="1.5"/>
      {tris.map((t,i)=><polygon key={i} points={t.pts} fill={t.fill} opacity="0.88"/>)}
      <path d="M100,100 C112,72 142,58 158,42 C163,68 150,93 128,106 Z" fill="#0d5c52" opacity="0.93"/>
      <path d="M100,100 C128,88 150,93 158,42 C146,48 132,63 116,80 Z" fill="#1a7a6e" opacity="0.6"/>
      <path d="M100,100 C88,128 58,142 42,158 C37,132 50,107 72,94 Z" fill="#1a7a6e" opacity="0.93"/>
      <path d="M100,100 C72,112 50,107 42,158 C54,152 68,137 84,120 Z" fill="#2a9d8f" opacity="0.6"/>
      <path d="M100,100 C72,88 50,93 42,42 C68,37 93,50 106,72 Z" fill="#d4571e" opacity="0.93"/>
      <path d="M100,100 C88,72 68,37 42,42 C58,58 74,70 90,86 Z" fill="#e06828" opacity="0.6"/>
      <path d="M100,100 C128,112 150,107 158,158 C132,163 107,150 94,128 Z" fill="#c84a10" opacity="0.93"/>
      <path d="M100,100 C112,128 132,163 158,158 C142,142 126,128 110,114 Z" fill="#d4571e" opacity="0.6"/>
      <g opacity="0.07" clipPath="url(#lc2)">{Array.from({length:18},(_,i)=>[<line key={`h${i}`} x1="14" y1={14+i*10} x2="186" y2={14+i*10} stroke="#000" strokeWidth="0.6"/>,<line key={`v${i}`} x1={14+i*10} y1="14" x2={14+i*10} y2="186" stroke="#000" strokeWidth="0.6"/>])}</g>
      <circle cx="100" cy="100" r="17" fill="#2e4828"/>
      <circle cx="100" cy="100" r="13" fill="url(#cg2)"/>
      <circle cx="100" cy="100" r="7" fill="#2e4828"/>
      <circle cx="100" cy="100" r="3.5" fill="#6a9060"/>
    </svg>
  );
}



